# Файл для ЛОКАЛЬНОЙ разработки и docker-compose.
#
# НЕ копируйте эти переменные в Vercel. Там нужны только SECRET_KEY и DEBUG
# (см. README, раздел «Деплой на Vercel»), а DATABASE_URL Vercel добавит сам
# при подключении Postgres. Однажды скопированный сюда ALLOWED_HOSTS с
# плейсхолдером erp.your-domain.kz положил весь демо-стенд: Django отвечал
# «400 Bad Request» вообще на любой запрос, включая /api/health/.

# Django
# SECRET_KEY обязателен: им подписываются токены входа. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Без него приложение не запустится (кроме демо на Vercel) — и это намеренно:
# со значением по умолчанию, которое лежит в репозитории, вход можно подделать.
SECRET_KEY=change-me-to-a-random-secret-in-production
# DEBUG=True только для разработки на своей машине. На сервере — False,
# иначе посетитель увидит трассировку со всеми настройками.
DEBUG=False
ALLOWED_HOSTS=erp.your-domain.kz
CORS_ALLOWED_ORIGINS=https://erp.your-domain.kz
# Включить, когда перед приложением уже стоит nginx/Caddy с сертификатом:
# принудительный https, secure-cookie и HSTS. Раньше времени включать нельзя —
# останетесь без доступа.
USE_HTTPS=False

# Postgres (used by docker-compose to build DATABASE_URL automatically)
POSTGRES_DB=autozap
POSTGRES_USER=autozap
POSTGRES_PASSWORD=change-me
